# Shared local settings. Only NEXT_PUBLIC_ settings are loaded by the frontend.
# Publishable browser key only; never use an sk_ secret key.
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# Optional local Supabase override (both values must come from the same project).
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<local anon or publishable key>

# Optional MCP entry point when a separate Node service has been deployed.
# NEXT_PUBLIC_AGENT_MCP_URL=http://127.0.0.1:8080/mcp

# Node API for private resume autofill. Public URL only; no Affinda key here.
# NEXT_PUBLIC_LOOKOUT_API_URL=http://127.0.0.1:8080

# Local account evaluation only; supply an existing @example.test account UUID.
INTELLIGENCE_ENTRYPOINT=backend/intelligence/account.ts
INTELLIGENCE_ACCOUNT_ID=
INTELLIGENCE_VECTOR_MODE=pending
INTELLIGENCE_SOURCE_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
# Set mode=openai and a server-only key explicitly to generate real embeddings.
OPENAI_API_KEY=

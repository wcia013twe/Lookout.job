{
  "name": "codex-automated-job-board",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test",
    "validate:data": "node scripts/validate-data.mjs",
    "test:db": "node backend/check-schema.mjs",
    "dev": "npm --prefix next-app run dev",
    "build": "npm --prefix next-app run build",
    "build:sites": "node scripts/build-sites.mjs",
    "feature:doctor": "node scripts/feature-delivery.mjs doctor",
    "feature:start": "node scripts/feature-delivery.mjs start",
    "feature:land": "node scripts/feature-delivery.mjs land",
    "feature:publish": "node scripts/feature-delivery.mjs publish",
    "feature:status": "node scripts/feature-delivery.mjs status",
    "intelligence:demo": "node backend/intelligence/demo.ts",
    "intelligence:mcp": "node backend/intelligence/mcp.ts",
    "intelligence:once": "node backend/intelligence/demo.ts --once",
    "intelligence:typecheck": "next-app/node_modules/.bin/tsc -p backend/intelligence/tsconfig.json",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:env": "node scripts/configure-local-supabase.mjs",
    "supabase:functions": "supabase functions serve --env-file supabase/functions/.env.local",
    "validate:local-db": "node backend/local/check-schema.mjs",
    "validate:local-edge": "node scripts/check-local-edge.mjs",
    "intelligence:account": "node backend/intelligence/account.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "js-yaml": "5.3.0",
    "pg": "8.16.3",
    "undici": "6.28.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.6",
    "@types/pg": "8.15.5",
    "esbuild": "0.25.12",
    "@types/node": "26.6.5",
    "supabase": "2.122.0",
    "typescript": "7.0.2"
  }
}

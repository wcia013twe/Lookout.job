# Server-only local Docker Node API configuration. Never commit populated values.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=
# Subscribe to APILayer's Resume Parser API and keep its key server-only.
APILAYER_API_KEY=
# Separate ATS worker switch; resume parsing does not need the worker enabled.
LOOKOUT_EXECUTION_ENABLED=false

# Cloud Run only; leave unset for local polling and Realtime event delivery.
# LOOKOUT_PROCESS=worker-once
# LOOKOUT_SEARCH_STAGING_BUCKET=private-staging-bucket
# LOOKOUT_EVENT_DELIVERY_MODE=request
# LOOKOUT_GCP_PROJECT=project-id
# LOOKOUT_GCP_REGION=us-east1
# LOOKOUT_CLOUD_RUN_JOB=lookout-discovery
# LOOKOUT_MAINTENANCE_AUDIENCE=https://lookout-api-PROJECT_NUMBER.us-east1.run.app
# LOOKOUT_SCHEDULER_EMAIL=lookout-run-scheduler@PROJECT_ID.iam.gserviceaccount.com

# Advertise/run guarded single and batch submissions in the API process.
# Independent of the ATS search worker. Every application still needs current authorization.
LOOKOUT_SUBMISSION_ENABLED=false

LOOKOUT_RECOMMENDATION_LOG_ENABLED=false
LOOKOUT_RECOMMENDATION_LOG_PROJECT=
LOOKOUT_RECOMMENDATION_LOG_SECRET=

# Muse tunnel settings belong in the repository-root .env.local; see README.md.

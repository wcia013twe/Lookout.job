# Server-only local Docker Node API configuration. Never commit populated values.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=
# Create a Resume Parser API key in the same region as AFFINDA_BASE_URL.
AFFINDA_API_KEY=
AFFINDA_BASE_URL=https://resume-parser.us1.affinda.com
# Only needed when your Affinda account has multiple Resume Parser organizations.
# AFFINDA_ORGANIZATION=
# Separate ATS worker switch; resume parsing does not need the worker enabled.
LOOKOUT_EXECUTION_ENABLED=false

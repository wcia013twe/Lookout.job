# Server-only local Docker Node API configuration. Never commit populated values.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=
# Subscribe to APILayer's Resume Parser API and keep its key server-only.
APILAYER_API_KEY=
# Separate ATS worker switch; resume parsing does not need the worker enabled.
LOOKOUT_EXECUTION_ENABLED=false

# Advertise/run guarded single and batch submissions in the API process.
# Independent of the ATS search worker. Every application still needs current authorization.
LOOKOUT_SUBMISSION_ENABLED=false

# Optional Muse development tunnel (make muse-dev).
# Assigned/reserved HTTPS base URL without /mcp.
NGROK_AUTHTOKEN=
NGROK_URL=

{
  "status": "proposal-not-deployed",
  "entities": {
    "Company": {
      "group": "01 Catalog and discovery",
      "fields": [
        "PK id: uuid",
        "name: text",
        "normalized_name: text",
        "domain: text?",
        "logo_asset: text?",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Shared employer identity; names alone are not unique. Registry controls aliases and merges."
    },
    "CompanyAlias": {
      "group": "01 Catalog and discovery",
      "fields": [
        "PK id: uuid",
        "FK company_id: uuid",
        "namespace: text",
        "alias_key: text",
        "label: text",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "UQ(namespace, alias_key) for verified aliases. Ambiguous names remain unresolved."
    },
    "Job": {
      "group": "01 Catalog and discovery",
      "fields": [
        "PK id: uuid",
        "FK company_id: uuid",
        "requisition_key: text?",
        "title: text",
        "type: FT / Internship",
        "locations: json[]",
        "setting: enum?",
        "focus: text?",
        "description: text?",
        "pay: json?",
        "eligibility: json?",
        "posted_at: date?",
        "state: enum",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "One employer requisition/cycle. FT or Internship. Pay preserves currency, basis, period, range and source; absence is unknown."
    },
    "Posting": {
      "group": "01 Catalog and discovery",
      "fields": [
        "PK id: uuid",
        "FK job_id: uuid",
        "canonical_url: text UQ",
        "provider: text?",
        "external_id: text?",
        "verified_at: timestamp?",
        "availability: enum",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Multiple verified employer/ATS URLs may resolve to one job. Tracking URL aliases normalize here; do not strip identity-bearing parameters."
    },
    "SearchRun": {
      "group": "01 Catalog and discovery",
      "fields": [
        "PK id: uuid",
        "FK owner_id: uuid?",
        "FK profile_document_id: uuid?",
        "FK profile_version_no: int?",
        "FK source_document_id: uuid?",
        "FK source_version_no: int?",
        "FK connection_id: uuid?",
        "scope: public / private",
        "mode: enum",
        "state: enum",
        "context_snapshot: json?",
        "checkpoints: json[]",
        "started_at: timestamp?",
        "completed_at: timestamp?",
        "event_key: text",
        "summary: text?",
        "updated_by: actor?",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Pin immutable profile + source-config document versions. Snapshot mutable candidate/answer/tier inputs once, without copying document bodies. Public runs use public source checkpoints, not private documents."
    },
    "SourceObservation": {
      "group": "01 Catalog and discovery",
      "fields": [
        "PK id: uuid",
        "FK run_id: uuid",
        "FK job_id: uuid?",
        "FK posting_id: uuid?",
        "source_key: text",
        "occurrence_key: text",
        "source_url: text",
        "observed_at: timestamp",
        "source_age_days: int?",
        "employer_date: date?",
        "evidence: json",
        "description: text?",
        "raw_lead: json?",
        "created_at: timestamp"
      ],
      "note": "Append-only occurrence. Allows unresolved social/list leads; employer verification required before canonical job admission. UQ(run, source_key, occurrence_key)."
    },
    "SelectionDecision": {
      "group": "01 Catalog and discovery",
      "fields": [
        "PK id: uuid",
        "FK owner_id: uuid",
        "FK profile_document_id: uuid",
        "FK profile_version_no: int",
        "FK observation_id: uuid",
        "FK job_id: uuid?",
        "decision: enum",
        "priority: enum?",
        "rationale: text",
        "checks: json[]",
        "gaps: json[]",
        "upside_tier: enum?",
        "exclusion_preference: json?",
        "certainty: enum?",
        "context_snapshot: json",
        "updated_by: actor?",
        "reconsidered_at: timestamp?",
        "revision: int",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Private assessment, not job fact. Pins profile version; context_snapshot captures candidate/tier/answer revisions and evidence used. Short rationale stays here; longer analysis links through DocumentLink."
    },
    "Batch": {
      "group": "01 Catalog and discovery",
      "fields": [
        "PK id: uuid",
        "FK owner_id: uuid?",
        "FK run_id: uuid",
        "scope: public / private",
        "label: text",
        "published_at: timestamp?",
        "event_key: text",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Public or private collection of selected jobs. Public batch date defines lastRun; a URL/id never grants private access."
    },
    "BatchItem": {
      "group": "01 Catalog and discovery",
      "fields": [
        "PK/FK batch_id: uuid",
        "PK/FK job_id: uuid",
        "FK decision_id: uuid?",
        "position: int",
        "discovered_date: date",
        "created_at: timestamp"
      ],
      "note": "FK batch_id \u2192 Batch; job_id \u2192 Job. UQ(batch, position). Private rationale comes from a same-owner decision; public editorial notes stay explicitly editorial."
    },
    "Account": {
      "group": "02 Candidate and preferences",
      "fields": [
        "PK id: uuid",
        "auth_subject: text UQ",
        "login_email: text",
        "settings: json",
        "personal_version: int",
        "settings_revision: int",
        "execution_policy: json",
        "policy_revision: int",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Settings are bounded preferences. execution_policy holds separately revisioned, profile-keyed human-controlled permissions. Profile prose may request a policy but cannot grant it."
    },
    "CandidateProfile": {
      "group": "02 Candidate and preferences",
      "fields": [
        "PK/FK owner_id: uuid",
        "contact: json",
        "summary: json",
        "links: json",
        "work: json[]",
        "education: json[]",
        "projects: json[]",
        "skills: json[]",
        "preferred_skills: text[]",
        "languages: json[]",
        "eligibility_by_country: json[]",
        "revision: int",
        "verified_revision: int?",
        "verified_at: timestamp?",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "One shared profile. Stable IDs inside ordered background entries. Verification is tied to values/revision; login email differs from application contact email."
    },
    "SavedAnswer": {
      "group": "02 Candidate and preferences",
      "fields": [
        "PK id: uuid",
        "FK owner_id: uuid",
        "FK company_id: uuid?",
        "scope_kind: enum",
        "scope_key: text",
        "scope_label: text?",
        "question: text",
        "normalized_key: text",
        "answer: text",
        "provenance: json",
        "reuse_policy: ask / reviewed_auto",
        "requested_policy: enum?",
        "revision: int",
        "reviewed_revision: int?",
        "reviewed_at: timestamp?",
        "archived_at: timestamp?",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "UQ(owner, exact normalized question, scope_key). Explicit global/resolved_company/unresolved_company scope; null company never implies global. Edit invalidates review. Draft snapshots preserve old answer text and revision."
    },
    "TierList": {
      "group": "02 Candidate and preferences",
      "fields": [
        "PK id: uuid",
        "FK owner_id: uuid",
        "name: text",
        "description: text",
        "ordered_tiers: json[]",
        "revision: int",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Small ordered definitions are embedded. Display rarity derives from tier; a list is reusable across profiles."
    },
    "TierPlacement": {
      "group": "02 Candidate and preferences",
      "fields": [
        "PK/FK list_id: uuid",
        "PK/FK company_id: uuid",
        "tier_key: text?",
        "position: int",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "FK list_id \u2192 TierList; company_id \u2192 Company. One company in one tier per list. Validate tier_key against that list."
    },
    "Document": {
      "group": "03 Documents and materials",
      "fields": [
        "PK id: uuid",
        "FK owner_id: uuid",
        "kind: enum",
        "key: text?",
        "title: text (head projection)",
        "variant: text?",
        "current_version_no: int",
        "projection: json (derived)",
        "projection_version_no: int",
        "reviewed_version_no: int?",
        "FK reviewed_by: uuid?",
        "reviewed_at: timestamp?",
        "archived_at: timestamp?",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Stable private identity for profile, source_config, analysis, resume, letter, template, toolkit material, debrief or collection. Projection is rebuilt from the current version; no second writable profile/source system. Review is editorial, not permission or fact verification."
    },
    "DocumentVersion": {
      "group": "03 Documents and materials",
      "fields": [
        "PK/FK document_id: uuid",
        "PK version_no: int",
        "title: text",
        "payload_kind: body / blob / url / manifest",
        "format: enum",
        "body: text?",
        "blob_key: text?",
        "source_url: text?",
        "sha256: text?",
        "mime: text?",
        "bytes: bigint?",
        "purpose: text",
        "sources: json[]",
        "schema_version: int",
        "attributes: json",
        "week_of: date?",
        "prepared_for: date?",
        "company_context: json?",
        "author: json",
        "input_refs: json[]",
        "created_at: timestamp"
      ],
      "note": "Immutable content. Body OR blob OR URL OR collection manifest by kind; attributes only allow enumerated kind-specific fields. Personal-agent output carries author/time and optional sources/input versions. Caveats remain in the body; no inference metadata. Collection children are bounded pinned references in attributes."
    },
    "DocumentLink": {
      "group": "03 Documents and materials",
      "fields": [
        "PK id: uuid",
        "FK document_id: uuid",
        "FK application_id: uuid?",
        "FK round_id: uuid?",
        "FK plan_id: uuid?",
        "FK task_id: uuid?",
        "FK company_target_id: uuid?",
        "FK job_id: uuid?",
        "FK decision_id: uuid?",
        "FK contact_id: uuid?",
        "FK conversation_id: uuid?",
        "FK run_id: uuid?",
        "FK profile_document_id: uuid?",
        "FK profile_version_no: int?",
        "relation: enum",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Exactly one typed subject; same owner for private targets. job_id may reference public Job. Many analyses can attach to one subject. Links locate content; input_refs records exactly what informed a revision."
    },
    "Application": {
      "group": "04 Applications and evidence",
      "fields": [
        "PK id: uuid",
        "FK owner_id: uuid",
        "FK job_id: uuid",
        "FK profile_document_id: uuid?",
        "opened_at: timestamp?",
        "queued_at: timestamp?",
        "recruiting_stage: enum",
        "stage_date: date?",
        "preparation_state: enum",
        "blocker: json?",
        "reported_applied_at: timestamp?",
        "revision: int",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "UQ(owner, job). Tracker and queued work are views over one relationship. Opening, queuing, user report and proven submission remain separate. No hard delete of referenced jobs."
    },
    "DraftRevision": {
      "group": "04 Applications and evidence",
      "fields": [
        "PK/FK application_id: uuid",
        "PK revision: int",
        "FK resume_document_id: uuid?",
        "FK resume_version: int?",
        "form_fingerprint: text?",
        "questions_answers: json[]",
        "profile_snapshot: json",
        "policy_snapshot: json",
        "answer_snapshots: json[]",
        "review_state: enum",
        "blockers: json[]",
        "actor: json",
        "created_at: timestamp"
      ],
      "note": "FK application_id \u2192 Application. Immutable reviewed material; snapshot exact fact/answer values with origin IDs and revisions. New revision invalidates old authorization."
    },
    "Authorization": {
      "group": "04 Applications and evidence",
      "fields": [
        "PK id: uuid",
        "FK application_id: uuid",
        "FK draft_revision: int",
        "kind: human / routine_policy",
        "actor: json",
        "policy_snapshot: json",
        "expires_at: timestamp?",
        "revoked_at: timestamp?",
        "material_digest: text",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Human approval requires real human actor; routine authorization requires validated policy and provenance. Neither proves submission. Recheck current safety conditions on claim."
    },
    "SubmissionAttempt": {
      "group": "04 Applications and evidence",
      "fields": [
        "PK id: uuid",
        "FK application_id: uuid",
        "FK draft_revision: int",
        "FK authorization_id: uuid",
        "state: enum",
        "idempotency_key: text",
        "claim: json",
        "click_permit_digest: text?",
        "executed_fields: json[]",
        "resume_evidence: json",
        "receipt: json?",
        "resolution: json?",
        "started_at: timestamp?",
        "finished_at: timestamp?",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "One active claim per application; one-use click permit. Captured fields are immutable; receipt/resolution append under version check. Uncertain blocks retry."
    },
    "ApplicationEvent": {
      "group": "04 Applications and evidence",
      "fields": [
        "PK id: uuid",
        "FK application_id: uuid",
        "FK round_id: uuid?",
        "kind: enum",
        "actor: json",
        "provenance: enum",
        "occurred_date: date?",
        "occurred_at: timestamp?",
        "precision: unknown / day / time",
        "recorded_at: timestamp",
        "payload: json",
        "event_key: text",
        "created_at: timestamp"
      ],
      "note": "Append-only timeline: status reports, email excerpts, observations, workflow transitions. Distinguish user report, agent observation and validated receipt. UQ(owner, event_key)."
    },
    "InterviewRound": {
      "group": "04 Applications and evidence",
      "fields": [
        "PK id: uuid",
        "FK application_id: uuid",
        "kind: enum",
        "label: text",
        "phase: enum",
        "scheduled_date: date?",
        "scheduled_time: time?",
        "timezone: text?",
        "date_confirmed: bool",
        "precision: unknown / day / time",
        "source: json",
        "notes: text",
        "revision: int",
        "updated_by: actor?",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Actual scheduled round is separate from prep deadline. Supports dated-but-unconfirmed or date-only records without inventing time; activity history refers to this row."
    },
    "PrepPlan": {
      "group": "05 Preparation and network",
      "fields": [
        "PK id: uuid",
        "FK owner_id: uuid",
        "FK application_id: uuid?",
        "goal_title: text?",
        "kind: application / learning",
        "deadline: date?",
        "confirmed: bool",
        "source: json",
        "state: enum",
        "revision: int",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Exactly application plan OR standalone learning goal. Goal identity is the plan ID; avoid a second identical plan system. Resource bodies live in documents."
    },
    "PrepTask": {
      "group": "05 Preparation and network",
      "fields": [
        "PK id: uuid",
        "FK plan_id: uuid",
        "title: text",
        "detail: text",
        "category: enum",
        "minutes: int",
        "due_date: date?",
        "position: int",
        "state: enum",
        "revision: int",
        "updated_by: actor?",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Stable tasks independently credited and linked to material. Plan revisions preserve credited task IDs; removed tasks archive. Shared practice joins via PracticeCredit."
    },
    "PracticeSession": {
      "group": "05 Preparation and network",
      "fields": [
        "PK id: uuid",
        "FK owner_id: uuid",
        "minutes: positive int",
        "completed_at: timestamp",
        "idempotency_key: text",
        "created_at: timestamp"
      ],
      "note": "UQ(owner, idempotency_key). Real practice duration counted once even if many tasks benefit; no duplicated minutes in total metrics."
    },
    "PracticeCredit": {
      "group": "05 Preparation and network",
      "fields": [
        "PK/FK session_id: uuid",
        "PK/FK task_id: uuid",
        "expected_plan_revision: int",
        "credited_minutes: int",
        "created_at: timestamp"
      ],
      "note": "FK session_id \u2192 PracticeSession; task_id \u2192 PrepTask. Same-owner, revision checked, credit bounded by session duration per target; aggregate time from session only."
    },
    "CompanyTarget": {
      "group": "05 Preparation and network",
      "fields": [
        "PK id: uuid",
        "FK owner_id: uuid",
        "FK company_id: uuid?",
        "unresolved_name: text?",
        "website: text?",
        "priority: enum",
        "interest: text",
        "teams: text[]",
        "questions: text[]",
        "next_action: text?",
        "follow_up_date: date?",
        "archived_at: timestamp?",
        "revision: int",
        "updated_by: actor?",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "UQ(owner, company) when resolved. Unresolved targets retain private label/website. Short interest/questions stay inline; long Research text is a linked analysis document, not a copied second body."
    },
    "Contact": {
      "group": "05 Preparation and network",
      "fields": [
        "PK id: uuid",
        "FK owner_id: uuid",
        "FK company_id: uuid?",
        "unresolved_company_name: text?",
        "name: text",
        "employment_role: text?",
        "contact_type: enum",
        "email: text?",
        "linkedin: text?",
        "evidence: text",
        "source_url: text?",
        "tags: text[]",
        "connection_context: text?",
        "reason: text?",
        "notes: text",
        "archived_at: timestamp?",
        "revision: int",
        "updated_by: actor?",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Private person identity shared by outreach and active processes. Exact verified email/LinkedIn dedupe within owner; never auto-merge names or globally share contacts."
    },
    "Conversation": {
      "group": "05 Preparation and network",
      "fields": [
        "PK id: uuid",
        "FK owner_id: uuid",
        "FK contact_id: uuid",
        "FK company_id: uuid?",
        "unresolved_company_name: text?",
        "target_role: text?",
        "subject: text",
        "draft_body: text",
        "channel: enum?",
        "outcome: enum",
        "follow_up_date: date?",
        "url: text?",
        "notes: text",
        "revision: int",
        "updated_by: actor?",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "One contact can have many threads. Referral outcome belongs to thread, not person/application. Draft text separate from logged messages; contact identity not copied."
    },
    "ConversationApplication": {
      "group": "05 Preparation and network",
      "fields": [
        "PK/FK conversation_id: uuid",
        "PK/FK application_id: uuid",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "FK conversation_id \u2192 Conversation; application_id \u2192 Application. Explicit same-owner process relationship replaces tags and URL guesses."
    },
    "Interaction": {
      "group": "05 Preparation and network",
      "fields": [
        "PK id: uuid",
        "FK conversation_id: uuid",
        "kind: message / meeting / coffee_chat",
        "direction: sent / received / null",
        "channel: LinkedIn / Email / null",
        "status: scheduled / completed / cancelled / null",
        "occurred_date: date",
        "body: text?",
        "notes: text?",
        "location: text?",
        "provenance: enum",
        "revision: int",
        "event_key: text",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Kind-specific checks. Messages carry sent/received; meetings carry scheduled/completed/cancelled. Logs report activity; they do not send or invite."
    },
    "Circle": {
      "group": "06 Circles and publication",
      "fields": [
        "PK id: uuid",
        "name: text",
        "revision: int",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Shared membership boundary. Owner is a membership role with exactly one active owner; transfer atomically."
    },
    "CircleMember": {
      "group": "06 Circles and publication",
      "fields": [
        "PK/FK circle_id: uuid",
        "PK/FK account_id: uuid",
        "alias: text",
        "role: owner / member",
        "state: active / left / removed",
        "allowed_contribution_types: enum[]",
        "joined_at: timestamp",
        "removed_at: timestamp?",
        "revision: int",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "FK circle_id \u2192 Circle; account_id \u2192 Account. Explicit membership controls read/write; agent proposal permissions are not human publication consent."
    },
    "CircleInvite": {
      "group": "06 Circles and publication",
      "fields": [
        "PK id: uuid",
        "FK circle_id: uuid",
        "token_hash: text UQ",
        "encrypted_token: text?",
        "FK created_by: uuid",
        "expires_at: timestamp",
        "revoked_at: timestamp?",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Invite secret is not ordinary stored plaintext; optional encrypted value for current UI redisplay. Removed members need a newer invite. Consume/join with membership checks; no private profile information disclosed."
    },
    "Post": {
      "group": "06 Circles and publication",
      "fields": [
        "PK id: uuid",
        "FK circle_id: uuid",
        "FK author_id: uuid",
        "FK parent_id: uuid?",
        "state: enum",
        "current_revision: int",
        "published_revision: int?",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "One post model for chat, round insights, resources, offers, milestones, opportunities and replies. Parent must be same circle; channel is derived from content type."
    },
    "PostRevision": {
      "group": "06 Circles and publication",
      "fields": [
        "PK/FK post_id: uuid",
        "PK revision: int",
        "type: enum",
        "title: text",
        "body: text",
        "contexts: json[]",
        "offers: json[]",
        "sources: json[]",
        "activity: json?",
        "insight: text?",
        "experience_date: date?",
        "provenance: enum",
        "uncertainty: text?",
        "agent_authored: bool",
        "personal_disclosure: bool",
        "FK human_approver: uuid?",
        "approved_at: timestamp?",
        "created_at: timestamp"
      ],
      "note": "FK post_id \u2192 Post. Immutable disclosure snapshot; redact private source. Personal disclosures require exact-revision approval. Restricted public-link templates may use explicit membership policy; validate no personal data. Human edits create new revision."
    },
    "PostPublication": {
      "group": "06 Circles and publication",
      "fields": [
        "PK/FK circle_id: uuid",
        "PK sequence: bigint",
        "FK post_id: uuid",
        "FK revision: int",
        "kind: publish / withdraw / hide",
        "actor: json",
        "occurred_at: timestamp",
        "created_at: timestamp"
      ],
      "note": "FK circle_id \u2192 Circle; composite post/revision \u2192 PostRevision. Atomic with post visibility. Durable cursor and tombstones; revision pinned for agent consumers."
    },
    "ModerationReport": {
      "group": "06 Circles and publication",
      "fields": [
        "PK id: uuid",
        "FK post_id: uuid",
        "FK reporter_id: uuid",
        "reason: text",
        "state: enum",
        "resolution: text?",
        "FK resolved_by: uuid?",
        "resolved_at: timestamp?",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Member-scoped report; moderator hides/withdraws with publication event. Report visibility restricted; no public reporter disclosure."
    },
    "AgentReceipt": {
      "group": "06 Circles and publication",
      "fields": [
        "PK id: uuid",
        "FK owner_id: uuid",
        "FK connection_id: uuid",
        "FK post_id: uuid",
        "FK post_revision: int",
        "category: enum",
        "reference: text",
        "retracted_at: timestamp?",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Private citation-use receipt, not publication approval. Source availability derives from current membership/visibility; retain redacted metadata after withdrawal."
    },
    "AgentConnection": {
      "group": "07 Agent execution and onboarding",
      "fields": [
        "PK id: uuid",
        "FK owner_id: uuid",
        "name: text",
        "credential_digest: text",
        "scopes: enum[]",
        "expires_at: timestamp?",
        "revoked_at: timestamp?",
        "capability_evidence: json",
        "revision: int",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "One-time secret delivery; digest only at rest. Capability evidence is time-stamped, not inferred from issuing credentials. Recheck scope/revocation every action."
    },
    "AgentCheckpoint": {
      "group": "07 Agent execution and onboarding",
      "fields": [
        "PK/FK connection_id: uuid",
        "PK context_key: text",
        "acknowledged_version: int?",
        "feed_cursor: json?",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "FK connection_id \u2192 AgentConnection. Per-agent context/feed cursor; acknowledge only after consuming. Developer version is release metadata, not mutable user data."
    },
    "OnboardingSession": {
      "group": "07 Agent execution and onboarding",
      "fields": [
        "PK id: uuid",
        "FK owner_id: uuid",
        "FK match_job_id: uuid?",
        "step: enum",
        "intent: text",
        "requested_policy: enum",
        "match_evidence: json?",
        "delivery_request: json?",
        "blocker: text?",
        "paused_from: enum?",
        "revision: int",
        "event_key: text",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "One current session/owner. Request state does not imply runner, notification or schedule active. Actual task outcomes remain separate."
    },
    "AgentTask": {
      "group": "07 Agent execution and onboarding",
      "fields": [
        "PK id: uuid",
        "FK owner_id: uuid",
        "FK session_id: uuid?",
        "FK connection_id: uuid?",
        "FK job_id: uuid?",
        "kind: enum",
        "state: enum",
        "revision: int",
        "event_key: text",
        "claim_expires_at: timestamp?",
        "target_companies: json[]",
        "result_refs: json",
        "result_summary: text?",
        "evidence: json",
        "updated_by: actor?",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "note": "Handoff inbox for personal agents to discover/prepare/execute and draft outreach; reasoning runs externally, not in Lookout; optional onboarding session. Bounded requested companies (up to 50); typed result references. Idempotent create, leased claim, uncertain reconciliation. References outcome IDs; no duplicated run/application snapshots."
    }
  },

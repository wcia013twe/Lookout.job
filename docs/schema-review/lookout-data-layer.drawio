  <diagram id="lookout-1" name="00a UI and AI content flow">
    <mxGraphModel adaptiveColors="auto" page="1" pageWidth="1500" pageHeight="1250" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Lookout · From UI input to stored content" style="text;html=1;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1360" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="DESIGN PROPOSAL · The UI edits named document sections or typed records. AI text uses the same ownership and version checks. No Markdown editing required." style="text;html=1;fontSize=14;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="70" width="1360" height="60" />
        </mxCell>
        <mxCell id="input" value="&lt;b&gt;1 · You use the existing UI&lt;/b&gt;&lt;br&gt;&lt;br&gt;Filters / Career goals / Rules / Sources&lt;br&gt;Example goal: “I want systems depth.”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#dae8fc;strokeColor=#64748b;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="170" width="430" height="190" />
        </mxCell>
        <mxCell id="patch" value="&lt;b&gt;2 · One validated save boundary&lt;/b&gt;&lt;br&gt;&lt;br&gt;Patch only the edited section + expected version.&lt;br&gt;Preserve unknown prose and source properties.&lt;br&gt;Reject duplicate headings, bad references, conflicts." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#d5e8d4;strokeColor=#64748b;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="520" y="170" width="430" height="190" />
        </mxCell>
        <mxCell id="doc" value="&lt;b&gt;3 · Canonical versioned document&lt;/b&gt;&lt;br&gt;&lt;br&gt;Document → immutable DocumentVersion&lt;br&gt;YAML fields + Markdown narrative&lt;br&gt;Same write boundary for website and scoped MCP." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#e1d5e7;strokeColor=#64748b;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1010" y="170" width="430" height="190" />
        </mxCell>
        <mxCell id="projection" value="&lt;b&gt;4 · Rebuildable UI / query projection&lt;/b&gt;&lt;br&gt;&lt;br&gt;Known filters / active profiles / source list&lt;br&gt;Read exact version; never separately editable.&lt;br&gt;Agent reads complete prose and exceptions too." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#dae8fc;strokeColor=#64748b;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1010" y="470" width="430" height="190" />
        </mxCell>
        <mxCell id="analysis" value="&lt;b&gt;5 · AI analysis and short explanations&lt;/b&gt;&lt;br&gt;&lt;br&gt;Long analysis → DocumentVersion.body&lt;br&gt;Short “why it fits” → SelectionDecision.rationale&lt;br&gt;Pin source/profile versions; record attribution." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#fff2cc;strokeColor=#64748b;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="520" y="470" width="430" height="190" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;6 · User reads, edits or reviews&lt;/b&gt;&lt;br&gt;&lt;br&gt;Analysis panel loads the linked version.&lt;br&gt;Editing creates a new revision.&lt;br&gt;“AI draft” / “edited” / “newer inputs available”." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#ffe6cc;strokeColor=#64748b;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="470" width="430" height="190" />
        </mxCell>
        <mxCell id="facts" value="&lt;b&gt;Structured facts and workflow&lt;/b&gt;&lt;br&gt;&lt;br&gt;CandidateProfile · Job · Application · events&lt;br&gt;Verified answers · permissions · exact approval&lt;br&gt;SubmissionAttempt + actual receipt" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fillColor=#f8cecc;strokeColor=#64748b;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="520" y="790" width="430" height="190" />
        </mxCell>
        <mxCell id="flow0" source="input" target="patch" edge="1" parent="1" value="" style="endArrow=classic;strokeColor=#64748b;fontSize=13;defaultLabelBackgroundColor=gap;edgeStyle=orthogonalEdgeStyle;rounded=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;html=1;">

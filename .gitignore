.DS_Store
node_modules/
/out/
/.sites-runtime/


supabase/.temp/

# Machine-generated conflict copies are not project history.
/CHANGELOG [0-9]*.md
/DESIGN [0-9]*.md
/.impeccable/design [0-9]*.json
/next-app/**/* [0-9]*.jsx
/next-app/**/* [0-9]*.tsx
/next-app/**/* [0-9]*.css
/next-app/scripts/* [0-9]*.mjs

# Local credentials and machine-specific frontend configuration.
.env
.env.*
!.env.example
!**/.env.example

# Private retained local presentation account/session.
/backend/runtime/.review-session.local.json

# Generated local profile-flow screenshots and server diagnostics.
/next-app/.profile-flow-proof/

# Private agent watcher configuration and runtime state.
/agent-package/*.config.json
/agent-package/*.state.json
/agent-package/*.lock
